#!/usr/bin/env php
<?php

define('TYPEPHP_BOOTED', true);

$autoloadFiles = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        require $file;
        break;
    }
}

use TypePHP\Internal\Cli\CommandRunner;

$exitCode = CommandRunner::run(array_slice($argv, 1));
exit($exitCode);